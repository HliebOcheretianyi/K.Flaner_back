SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ISSUER=kflaner-back
JWT_AUDIENCE=kflaner
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

PAYMENT_MANAGER_SERVICE_TOKEN=

PAYMENT_MANAGER_URL=http://localhost:8080
# Must equal payment-manager's SERVICE_TOKEN (at least 32 bytes)
PAYMENT_MANAGER_SERVICE_TOKEN=change-me-to-a-random-string-of-at-least-32-bytes
# payment-manager's docker-compose exposes Kafka to the host on 9094
KAFKA_BROKERS=localhost:9094
KAFKA_PAYMENT_STATUS_TOPIC=payment.status-changed
KAFKA_CONSUMER_GROUP=kflaner-back
