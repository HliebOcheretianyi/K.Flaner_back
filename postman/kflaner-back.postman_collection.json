            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"first_name\": \"Taras\",\n  \"last_name\": \"Shevchenko\"\n}",
              "options": {
                "raw": {
