                "exec": [
                  "pm.test(\"status is 403\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([403]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PM: create invoice with Django user token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paymentManagerUrl}}/payment/mono/invoice"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intentItems\": [\n    {\n      \"id\": \"{{productId}}\",\n      \"amount\": 1\n    }\n  ],\n  \"redirectUrl\": \"https://example.com/thanks\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Proves payment-manager accepts tokens issued by Django. 502 means monobank rejected the invoice (e.g. missing/invalid MONO_TOKEN); auth itself passed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201 or 502\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 502]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set(\"paymentId\", body.paymentId);",
                  "    pm.collectionVariables.set(\"pageUrl\", body.pageUrl);",
                  "    console.log(\"Pay here, then run \\\"4. After payment\\\":\", body.pageUrl);",
                  "}"
                ]
              }
            }
          ]
        }
      ],
      "description": "Needs payment-manager running on {{paymentManagerUrl}} and {{serviceToken}} set to the same value as SERVICE_TOKEN / PAYMENT_MANAGER_SERVICE_TOKEN."
    },
    {
      "name": "4. After payment (manual)",
      "item": [
        {
          "name": "My products contains the paid product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/products/"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Open {{pageUrl}} from the previous step, pay with a monobank test card, wait for the success event to reach the consumer (scripts/start.sh), then send this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"paid product is listed\", function () {",
                  "    const ids = pm.response.json().items.map(item => item.id);",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get(\"productId\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Skipped in automated runs: needs a real payment through the monobank page."
    },
    {
      "name": "5. Cleanup",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh after logout → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PM: delete product with service token",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Service-Token",
                "value": "{{serviceToken}}"
              }
            ],
            "url": {
              "raw": "{{paymentManagerUrl}}/products/{{productId}}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([204]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
