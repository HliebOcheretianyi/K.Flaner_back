{
  "info": {
    "name": "K.Flaner backend (local)",
    "description": "Checks the K.Flaner Django API and its integration with payment-manager. Run top to bottom: each run registers a fresh user and stores tokens and ids in collection variables.\n\nSet `serviceToken` to your SERVICE_TOKEN before running folder 3. Folder 4 needs a real monobank payment and is meant to be sent by hand.\n\nAuth endpoints are rate limited (AUTH_THROTTLE_RATE, default 10/min); one run uses exactly 10 auth requests, so wait a minute between runs or raise the rate in .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/health/"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register: weak password → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"123\",\n  \"first_name\": \"Taras\",\n  \"last_name\": \"Shevchenko\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `reader+${Date.now()}@example.com`);",
                  "pm.collectionVariables.set(\"password\", \"correct-horse-battery-staple\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400]);",
                  "});",
                  "pm.test(\"error code is validation_error\", function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql(\"validation_error\");",
                  "});",
                  "pm.test(\"error field is password\", function () {",
                  "    pm.expect(pm.response.json().error.field).to.eql(\"password\");",
                  "});"
                ]
              }
            }
          ]
        },
